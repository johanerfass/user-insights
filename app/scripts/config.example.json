{
  "reddit": {
    "enabled": true,
    "queries": ["Voi scooter", "Voi ebike", "Voi app"],
    "subreddits": [],
    "limit": 50,
    "userAgent": "voi-rider-signal-bot/1.0 (contact: you@voiapp.io)"
  },
  "appStore": {
    "enabled": true,
    "appId": "REPLACE_WITH_VOI_APP_STORE_ID",
    "countries": ["gb", "se", "de", "fr", "es"],
    "pages": 1
  },
  "googlePlay": {
    "enabled": true,
    "appId": "com.voiapp.voi",
    "countries": ["gb", "se", "de", "fr", "es"],
    "num": 50
  },
  "trustpilot": {
    "enabled": true,
    "businessUnitId": "REPLACE_WITH_TRUSTPILOT_BUSINESS_UNIT_ID",
    "apiKeyEnvVar": "TRUSTPILOT_API_KEY",
    "csvImportPath": "./data/trustpilot-import.csv",
    "perPage": 100
  },
  "news": {
    "enabled": true,
    "googleNews": {
      "enabled": true,
      "queries": ["Voi scooter", "Voi ebike", "Voi micromobility"],
      "editions": [
        { "hl": "en-GB", "gl": "GB", "lang": "en" },
        { "hl": "sv", "gl": "SE", "lang": "sv" },
        { "hl": "de", "gl": "DE", "lang": "de" }
      ]
    },
    "feeds": {
      "enabled": true,
      "urls": []
    }
  },
  "x": {
    "enabled": true,
    "queries": ["Voi scooter", "Voi ebike"],
    "maxResults": 25,
    "bearerTokenEnvVar": "X_BEARER_TOKEN"
  },
  "mastodon": {
    "enabled": true,
    "instances": ["mastodon.social"],
    "hashtags": ["escooter", "voi", "micromobility"],
    "limit": 40
  },
  "bluesky": {
    "enabled": true,
    "queries": ["Voi scooter", "Voi ebike"],
    "limit": 25,
    "identifierEnvVar": "BLUESKY_IDENTIFIER",
    "appPasswordEnvVar": "BLUESKY_APP_PASSWORD"
  },
  "window": {
    "minPostsForWindow": 5,
    "candidates": [
      { "label": "Last week", "days": 7 },
      { "label": "Last month", "days": 30 },
      { "label": "Last 6 weeks", "days": 42 },
      { "label": "Last quarter", "days": 90 }
    ]
  },
  "sourceLabels": [
    "Trustpilot",
    "App Store",
    "Google Play",
    "Reddit",
    "News",
    "X",
    "Mastodon",
    "Bluesky"
  ],
  "rotateSeconds": 12,
  "classification": {
    "useClaude": false,
    "model": "claude-haiku-4-5-20251001"
  }
}
