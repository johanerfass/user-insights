# Copy to .env and fill in what you have. Every source degrades gracefully
# when its credentials are missing — the pipeline just skips that source and
# keeps going.

# Trustpilot Business API key, scoped to your business unit.
# https://developers.trustpilot.com/
TRUSTPILOT_API_KEY=

# X (Twitter) API v2 bearer token. X has no free search tier, so this needs a
# paid API plan — without it the X source is skipped and the rest still runs.
# https://developer.x.com/en/portal/products
X_BEARER_TOKEN=

# Bluesky handle (e.g. you.bsky.social) plus an app password from
# Settings → Privacy and security → App passwords — NOT your account password.
# Bluesky's search endpoint returns 403 without a logged-in session.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Optional: use Claude to classify sentiment/themes instead of the built-in
# keyword heuristic. Also flip classification.useClaude to true in
# scripts/config.json to enable it.
ANTHROPIC_API_KEY=
