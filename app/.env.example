# Copy to .env and fill in what you have. Every source degrades gracefully
# when its credentials are missing — the pipeline just skips that source and
# keeps going.

# Trustpilot Business API key, scoped to your business unit.
# https://developers.trustpilot.com/
TRUSTPILOT_API_KEY=

# Optional: use Claude to classify sentiment/themes instead of the built-in
# keyword heuristic. Also flip classification.useClaude to true in
# scripts/config.json to enable it.
ANTHROPIC_API_KEY=
